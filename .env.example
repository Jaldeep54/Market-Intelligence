# Supabase project settings (Project Settings -> API in the Supabase dashboard).
# These are safe to expose to the browser -- they only grant the access your
# Row Level Security policies allow (see supabase/migrations).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. From https://aistudio.google.com/apikey (Gemini API key,
# free tier is fine to start). Never prefix with NEXT_PUBLIC_, never
# reference from client code -- see src/lib/ai/gemini.ts.
GEMINI_API_KEY=

# Which Gemini model prepares News Inbox articles. Optional -- if unset, the
# app falls back to a current free-tier-compatible model
# (see DEFAULT_MODEL in src/lib/ai/gemini.ts). Change this instead of
# editing code if Google renames/retires a model.
GEMINI_MODEL=gemini-2.5-flash

# Note: the 2-hour scheduled news-source check is NOT configured here or in
# Vercel at all. It runs entirely inside Supabase (pg_cron + pg_net calling
# the "fetch-sources" Edge Function) -- see docs/SETUP.md section 7 and
# supabase/migrations/20260101000007_supabase_cron_dispatch.sql.

# Server-only. From Supabase -> Project Settings -> API -> service_role key.
# Bypasses Row Level Security and grants full auth-management access
# (supabase.auth.admin.*) -- never prefix with NEXT_PUBLIC_, never reference
# from client code. Used only by src/lib/supabase/admin.ts, for the admin
# panel's "Set new password" action.
SUPABASE_SERVICE_ROLE_KEY=

# Web Push (new-article notifications -- see src/lib/push/). Generate a pair
# with `npx web-push generate-vapid-keys`. The public key is safe to expose
# to the browser (it's how the browser verifies pushes come from this
# server); the private key is server-only and must never be committed or
# referenced from client code -- see src/lib/push/send.ts.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
