# Supabase project settings (Project Settings -> API in the Supabase dashboard).
# These are safe to expose to the browser -- they only grant the access your
# Row Level Security policies allow (see supabase/migrations).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Never add the service role key here or anywhere in this repository.
# This app never needs it: all access control is enforced by Postgres RLS.
