# Supabase project settings (Project Settings -> API in the Supabase dashboard).
# These are safe to expose to the browser -- they only grant the access your
# Row Level Security policies allow (see supabase/migrations).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Used exclusively by the scheduled news-source check
# (src/app/api/cron/fetch-sources) to write as "the system" when no admin is
# logged in, bypassing Row Level Security. Never prefix with NEXT_PUBLIC_,
# never reference from client code. Get it from Project Settings -> API ->
# "service_role" (Supabase dashboard).
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret that authorizes calls to the scheduled fetch route. Generate
# any long random string and set the same value in Vercel's project
# environment variables -- Vercel Cron sends it automatically as a Bearer
# token once both are set. Server-only.
CRON_SECRET=

# Server-only. From https://aistudio.google.com/apikey (Gemini API key,
# free tier is fine to start). Never prefix with NEXT_PUBLIC_, never
# reference from client code -- see src/lib/ai/gemini.ts.
GEMINI_API_KEY=

# Which Gemini model prepares News Inbox articles. Optional -- if unset, the
# app falls back to a current free-tier-compatible model
# (see DEFAULT_MODEL in src/lib/ai/gemini.ts). Change this instead of
# editing code if Google renames/retires a model.
GEMINI_MODEL=gemini-2.5-flash
